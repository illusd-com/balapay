# Turso (required for production)
TURSO_DATABASE_URL=libsql://your-db-xxx.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# JWT secret (required in production – use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# NVIDIA NIM (optional – AI help)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
